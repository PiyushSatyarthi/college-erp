NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (Project Settings -> Database -> Connection string -> URI)
# Used only by db:migrate / db:seed to run DDL, since the Supabase REST client
# (@supabase/supabase-js) cannot execute arbitrary SQL/DDL.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

JWT_SECRET=change-me-before-production
JWT_EXPIRES_IN=8h

# Optional: enables /api/ai/chat for Student/Faculty/Parent AI assistants.
# Get your key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# AI Assistant — uses Groq (free tier, ~500 tokens/s).
# Get a free key at https://console.groq.com
# Without this key the AI assistant pages show a friendly error; everything else works.
GROQ_API_KEY=gsk_...
