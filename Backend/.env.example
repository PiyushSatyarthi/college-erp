NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (Project Settings -> Database -> Connection string -> URI)
# Used only by db:migrate / db:seed to run DDL, since the Supabase REST client
# (@supabase/supabase-js) cannot execute arbitrary SQL/DDL.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

JWT_SECRET=change-me-before-production
JWT_EXPIRES_IN=8h
